{
  "name": "novel-creator-pro",
  "version": "1.0.0",
  "description": "智能小说创作软件 - AI驱动的章节大纲生成、内容创作与世界设定管理",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "npm run build && electron-builder",
    "server": "node server/server.js",
    "server:dev": "concurrently \"npm run server\" \"npm run dev\""
  },
  "keywords": ["novel", "ai", "writing", "deepseek"],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "vite": "^5.0.0",
    "vue": "^3.4.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0",
    "concurrently": "^8.2.0",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "vue-router": "^4.2.5",
    "pinia": "^2.1.7",
    "element-plus": "^2.5.0",
    "@element-plus/icons-vue": "^2.3.1",
    "marked": "^11.0.0",
    "dompurify": "^3.0.6",
    "express": "^4.18.2",
    "cors": "^2.8.5"
  },
  "build": {
    "appId": "com.novelcreator.pro",
    "productName": "小说创作大师",
    "directories": {
      "output": "dist-electron"
    },
    "win": {
      "target": "nsis"
    }
  }
}
